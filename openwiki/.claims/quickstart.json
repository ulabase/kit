    {
      "id": "claim_41bbdb160e6848b99a5eb9769956cae7",
      "statement": "formatPrice converts minor-unit amounts (cents) to locale-aware display strings using Intl.NumberFormat. It handles all ISO 4217 currencies including zero-decimal ones like JPY.",
