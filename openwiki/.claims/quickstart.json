    {
      "id": "claim_be41b5045b1e4241b5e8d527d4615e35",
      "statement": "The architecture follows a layered pattern: core kit (all network calls, token operations, business rules), framework adapters (reactive wrappers), SSR subpaths (server-side token management), and CLI (declarative service configuration, independent of the frontend kit). An adapter that reimplements an API call or token computation is a bug.",
      "evidence": [
        {
          "resource": "repo://packages/cli/package.json",
          "version": "repo-file-v1:sha256:8ec2a68ebaccf301d938e3f0e6de072356304d16851f4f597f7f7a13b5399b2e"
