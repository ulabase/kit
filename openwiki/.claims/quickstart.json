    {
      "id": "claim_3e75f4a42f4440ca8a100ee11549831e",
      "statement": "createOrder creates an order and starts Stripe Checkout. Prices are resolved server-side from catalogItem.unitAmount on the server — never from anything the client sends. Guest checkout is supported via an email parameter; the returned secret lets guests look up their order without a session.",
      "evidence": [
        {
          "resource": "repo://packages/kit/src/orders.ts#L126-L145",
          "version": "repo-lines-v1:sha256:a0a4a10c5ea7b3930ce1791259ef8039502e79033671dcf33189d5476afb2122:"
