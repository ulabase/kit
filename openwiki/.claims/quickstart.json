    {
      "id": "claim_fba77367b0d742b5aa33cf8d61aee2d9",
      "statement": "getCatalog reads a MongoDB collection (configurable name, default 'catalog') with pagination, filtering, and sorting. Access is controlled by the deployment's own ACL; the kit does not add readFilter restrictions.",
      "evidence": [
