    {
      "id": "claim_eb099f5a672f46b69328b6ba3a6845bf",
      "statement": "readOrderRef reads the order reference from the Checkout return URL, checking the fragment first then the query string. The fragment is preferred because it never leaves the browser (absent from access logs, proxy logs, and Referer headers), which matters because the secret is a bearer credential.",
      "evidence": [
        {
          "resource": "repo://packages/kit/src/orders.ts#L147-L214",
