    {
      "id": "claim_3973a271db7d44b6b55ce5452e57d993",
      "statement": "The Ulabase Kit monorepo contains five packages: @ulabase/kit (framework-agnostic core), @ulabase/cli (ulabase command-line tool with ula alias), @ulabase/kit-ng (Angular adapter), @ulabase/kit-react (React adapter with /next subpath), and @ulabase/kit-vue (Vue adapter with /nuxt subpath).",
      "evidence": [
        {
          "resource": "repo://packages/cli/package.json",
          "version": "repo-file-v1:sha256:8ec2a68ebaccf301d938e3f0e6de072356304d16851f4f597f7f7a13b5399b2e"
        },
        {
