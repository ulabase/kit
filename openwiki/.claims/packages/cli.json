    },
    {
      "id": "claim_d8de3ebadeb74c8f87c52daecb68441c",
      "statement": "The package is Node-only by design: the admin node's originVetoer rejects browser-origin requests (whitelisting ulabase.com, allowing a missing Origin header). It is not a framework adapter — there is no reactive state, no session to restore, no signal to update.",
      "evidence": [
        {
          "resource": "repo://packages/cli/README.md",
          "version": "repo-file-v1:sha256:1184947e801060f7e006cfb9093cc70d39480c5155c9be46818adf67274787ef"
