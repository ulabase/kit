    {
      "id": "claim_c27cbd800c2047af89d1801be32c0155",
      "statement": "The REDACTED constant ('••••••••') mirrors the server's PluginSecretsRedactor.REDACTED. It is exported so callers can recognise a placeholder; nothing in the package ever produces one. isRedacted() checks for it. A blank or absent secret is not redacted.",
      "evidence": [
        {
          "resource": "repo://packages/cli/src/types.ts#L1-L22",
          "version": "repo-lines-v1:sha256:d949a7028c81d187575fba000de038afae79b501a6554b731939aad7cc0f4fd3:"
        }
