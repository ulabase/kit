    {
      "id": "claim_b705829eef8847719304e2eab4f3ef7a",
      "statement": "Stripe sends the buyer back to successUrl over the browser and reports the payment over a separate server-to-server webhook with no ordering guarantee. The fix is waitForSubscription/waitForOrder, which poll immediately (no initial delay), accept a caller-supplied predicate, throw WaitTimeoutError (not ApiError) on timeout, and support AbortSignal for cancellation.",
      "evidence": [
        {
          "resource": "repo://packages/kit/src/orders.ts#L243-L285",
          "version": "repo-lines-v1:sha256:5458109a38e68d24a3d1cfca5a24be6ac79737b70ff0e8563f627011937e73ed:"
        },
