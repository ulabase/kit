        }
      ]
    },
    {
      "id": "claim_a59f35d418ac4117a9a4f74d9f7e9bba",
      "statement": "The core AuthConfig accepts optional callbacks for customization: getToken (custom token source), setToken (custom token sink), transport (custom fetch, e.g., Angular HttpClient), onError (global error observer), payments (opt-in to payment features), and ownershipRole (role for billing management, default 'owner'). When setToken is provided, localStorage and the refresh timer are both bypassed for SSR runtimes.",
      "evidence": [
        {
          "resource": "repo://packages/kit-ng/src/http-transport.ts#L41-L91",
          "version": "repo-lines-v1:sha256:92f459ec1cc75d0e892c3147034a52589b4dad6f77d51348b50231ed13580f2d:"
        },
        {
