        }
      ]
    },
    {
      "id": "claim_38249586080a411984b27433f956e7ff",
      "statement": "The CLI's AdminClient authenticates against the admin node (cloud-api.restheart.com), manages features using feature-based primary method names (installFeature, getFeatureConfig, updateFeatureConfig, initFeature, testFeature, etc.) with deprecated plugin method aliases for backward compatibility, mints service tokens, and stores credentials in a closure rather than localStorage to support Node.js and avoid cross-client token collision.",
      "evidence": [
        {
          "resource": "repo://packages/cli/src/admin.ts#L154-L288",
          "version": "repo-lines-v1:sha256:ff808d2612186d5151bd3804c2fb74d50108cc4d8ce33a60344662d0824ac7e7:"
