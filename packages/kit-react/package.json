{
  "name": "@ulabase/kit-react",
  "version": "0.0.0",
  "description": "React context, hooks, and route guards for Ulabase authentication and payments — wraps @ulabase/kit. Includes a /next subpath for Next.js server-side rendering.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ulabase/kit.git",
    "directory": "packages/kit-react"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-router-dom": ">=6",
    "next": ">=14"
  },
  "peerDependenciesMeta": {
    "react-router-dom": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "@ulabase/kit": "0.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10",
    "@testing-library/react": "^16",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^26",
    "next": "^15",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7",
    "typescript": "^5",
    "vitest": "^4"
  }
}
